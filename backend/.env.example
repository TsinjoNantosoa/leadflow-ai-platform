# ===================================================================================================
# LeadFlow AI — backend (FastAPI). Copier en `.env` (ignoré par Git). AUCUNE vraie clé dans ce fichier.
# Contrat de configuration unique : chaque variable ci-dessous est réellement lue par app/core/config.py.
# ===================================================================================================

# --- Application ----------------------------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
DEFAULT_ORG_SLUG=novadigital

# --- PostgreSQL -----------------------------------------------------------------------------------
# Local (docker compose up -d db) :
DATABASE_URL=postgresql+psycopg://leadflow:leadflow_local@localhost:5433/leadflow
# Neon : URL "pooled" (host contenant -pooler) avec ?sslmode=require ; une URL postgres:// ou postgresql://
# est acceptée et convertie automatiquement vers le driver psycopg 3.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon : URL directe (sans -pooler) utilisée UNIQUEMENT par Alembic. Laisser vide en local.
DATABASE_URL_DIRECT=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=15
# Exécute `alembic upgrade head` au démarrage du conteneur (voir scripts/entrypoint.sh).
RUN_MIGRATIONS_ON_START=false

# --- Web, CORS, sessions --------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=               # origines supplémentaires séparées par des virgules (ex. aperçus Vercel)
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"   (>= 32 caractères en production)
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=lf_session
# lax : frontend et API sur la même origine (proxy Vercel /api -> Render, recommandé).
# none : domaines différents sans proxy (exige HTTPS, cookies tiers parfois bloqués par les navigateurs).
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=              # vide => true en production, false sinon
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# true derrière Render/Vercel pour lire l'IP cliente dans X-Forwarded-For (rate limit public).
TRUST_PROXY_HEADERS=false

# --- API publique ---------------------------------------------------------------------------------
PUBLIC_RATE_LIMIT_PER_HOUR=25
MAX_LEAD_MESSAGE_LENGTH=4000
PRIVACY_NOTICE_VERSION=2026-10-v1

# --- Appels internes n8n -> FastAPI ---------------------------------------------------------------
# Secret partagé : à copier dans le credential n8n "LF - LeadFlow API Service Token".
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"   (>= 32 caractères en production)
API_SERVICE_TOKEN=
INTERNAL_MAX_CLOCK_SKEW_SECONDS=300

# --- LLM ------------------------------------------------------------------------------------------
LLM_PROVIDER=mock                   # mock (aucune clé, aucun réseau) | openai
OPENAI_API_KEY=                     # requis si LLM_PROVIDER=openai ; jamais dans Git ni dans le frontend
# Modèle supportant les Structured Outputs. Défaut recommandé : gpt-4.1-mini (voir docs/OPENAI_INTEGRATION.md).
# Alternative documentée si indisponible pour votre clé : gpt-4o-mini.
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=1
LLM_MAX_OUTPUT_TOKENS_EXTRACTION=600
LLM_MAX_OUTPUT_TOKENS_DRAFT=900
LLM_MAX_CONCURRENCY=4
LLM_DAILY_CALL_LIMIT=0              # 0 = illimité ; sinon plafond d'appels non-mock par jour (UTC)
# Estimation de coût : renseigner les tarifs officiels (USD / million de tokens) pour activer l'estimation.
# Vide => aucune estimation n'est calculée (jamais de coût inventé).
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# --- CRM / e-mail ---------------------------------------------------------------------------------
CRM_PROVIDER=mock                   # mock | hubspot. Le token HubSpot vit UNIQUEMENT dans un credential n8n.
ENABLE_REAL_EMAIL_SEND=false        # doit rester false : aucun envoi d'e-mail n'existe dans le MVP

# --- Outbox (le backend est l'unique autorité des retries) -----------------------------------------------
OUTBOX_LEASE_SECONDS=300
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_SECONDS=30
OUTBOX_BACKOFF_MAX_SECONDS=3600
OUTBOX_CLAIM_BATCH_MAX=20

# --- Rétention (scripts/purge_retention.py) ---------------------------------------------------------------
RETENTION_OUTBOX_DAYS=30
RETENTION_IDEMPOTENCY_DAYS=7
RETENTION_SESSIONS_DAYS=7

# --- Seed de démonstration (scripts/seed_demo.py) -----------------------------------------------------
# Obligatoires en production (>= 10 caractères). En développement, vides => mot de passe aléatoire affiché une fois.
DEMO_ADMIN_PASSWORD=
DEMO_SALES_PASSWORD=

# --- Réveil best-effort de n8n (optionnel) ---------------------------------------------------------
# Après chaque soumission, le backend prévient WF-04 pour réduire la latence. Sans effet sur la fiabilité.
N8N_WAKE_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_WAKE_TIMEOUT_SECONDS=3
# Nombre de proxys de confiance devant l'API (X-Forwarded-For lu depuis la droite). Utilisé si TRUST_PROXY_HEADERS=true.
TRUSTED_PROXY_HOPS=1
